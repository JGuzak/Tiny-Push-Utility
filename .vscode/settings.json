{
    "markdown-pdf.breaks": true,
    "markdown-pdf.convertOnSave": true,
    "markdown-pdf.convertOnSaveExclude": [
        "^(?!user-manual.md$).+$"
    ],
    "markdown-pdf.displayHeaderFooter": true,
    "markdown-pdf.includeDefaultStyles": true,
    "markdown-pdf.footerTemplate": "<div style=\"font-size: 9px; margin: 0 auto;\"> <span class='pageNumber'></span> of <span class='totalPages'></span></div>",
    "markdown-pdf.headerTemplate": "<div></div>",
    "markdown-pdf.styles": [
        "./user-manual.css"
    ],
    "markdown-pdf.type": [
        "pdf"
    ],
    "markdownlint.run": "onSave",
    "markdownlint.configFile": ".markdownlint.json"
}